{
	// STREAMS 관리자 통계 — 공개 사이트(my-site)와 따로 배포한다. 설정: docs/streams-admin.md
	//   npx wrangler deploy -c admin/wrangler.jsonc
	// workers.dev 주소 전체를 Cloudflare Access 로 막는다 (Worker 설정 → Domains & Routes → workers.dev → Access).
	"name": "streams-admin",
	"main": "index.ts",
	"compatibility_date": "2026-09-20",
	"workers_dev": true,
	// 공개 사이트와 같은 기록 DB — 통계·내보내기는 읽기, 설정(site_settings) 쓰기와 테스트 기록 정리만 쓴다
	"d1_databases": [
		{ "binding": "DB", "database_name": "streams-records", "database_id": "eeda2e62-917f-4c23-958e-56e202cfd302" }
	],
	// 공개 사이트(my-site)의 실시간 통계 DO — 공개 카드 설정을 바꾸면 다시 읽으라고 알린다
	"durable_objects": {
		"bindings": [{ "name": "STATS", "class_name": "StatsHub", "script_name": "my-site" }]
	},
	// Access 를 켠 뒤 채운다. 비어 있으면 모든 요청을 막는다 (닫힌 채로 시작)
	"vars": {
		"ACCESS_TEAM_DOMAIN": "flat-water-0474.cloudflareaccess.com",
		"ACCESS_AUD": "33fef709014ccc79eafc434bad0029c6bfaf0864d67d53b3842a3a3ff396e8a0"
	},
	"observability": { "enabled": true }
}
