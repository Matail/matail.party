{
	// Cloudflare Workers 배포 설정.
	// 이 파일이 없으면 `wrangler deploy` 가 진입점을 못 찾아 대화형 자동설정으로 빠지고,
	// CI 에서는 그게 실패한다 (Missing entry-point to Worker script or to assets directory).
	//
	// 사이트는 astro build 결과(dist/)를 정적 파일로 서빙한다.
	// 요청은 Worker 코드(worker/index.ts)가 먼저 받아 /api/* 는 STREAMS 게임 API 로, 옛 주소는 matail.party 로 넘기고
	// 나머지는 정적 파일로 보낸다.
	"name": "my-site",
	"main": "worker/index.ts",
	// 대표 주소. Worker 이름(my-site)은 그대로 둔다 — 바꾸면 새 Worker 가 되어 실시간 통계 DO 가 끊긴다
	"routes": [{ "pattern": "matail.party", "custom_domain": true }],
	// routes 가 있으면 wrangler 는 workers.dev 주소를 기본으로 끈다. 옛 주소(→ 301)와 브랜치 미리보기 주소를
	// 살려 두려고 둘 다 명시적으로 켠다
	"workers_dev": true,
	"preview_urls": true,
	"compatibility_date": "2026-09-20",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// 모든 요청을 Worker 가 먼저 본다 — 옛 주소(workers.dev)로 온 요청을 matail.party 로 넘기려면
		// 호스트를 봐야 하는데, 정적 파일이 먼저 나가면 그 기회가 없다 (worker/index.ts)
		"run_worker_first": true
	},
	// STREAMS 플레이 기록 (비공개). 스키마: migrations/
	"d1_databases": [
		{ "binding": "DB", "database_name": "streams-records", "database_id": "eeda2e62-917f-4c23-958e-56e202cfd302", "migrations_dir": "migrations" }
	],
	// STREAMS AI 가중치 (비공개, 리포에 넣지 않음). 키: streams/human_bc.bin, streams/sgaz_d.bin, streams/manifest.json
	"kv_namespaces": [
		{ "binding": "MODELS", "id": "b55048675931487b91162e41b0704667" }
	],
	// STREAMS 실시간 통계 — 집계와 웹소켓 방송을 한 곳에서 (worker/streams/stats.ts)
	// AIMBOOSTER 실시간 집계 · 상위 % 도 같이 (worker/aimbooster/stats.ts)
	"durable_objects": {
		"bindings": [
			{ "name": "STATS", "class_name": "StatsHub" },
			{ "name": "AIM_STATS", "class_name": "AimStatsHub" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["StatsHub"] },
		{ "tag": "v2", "new_sqlite_classes": ["AimStatsHub"] }
	],
	// 요청이 먼 데이터센터(예: DFW)로 가도 D1(ICN) 가까이에서 Worker 를 돌리도록
	"placement": { "mode": "smart" },
	"observability": {
		"enabled": true
	}
}
