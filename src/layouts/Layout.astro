---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Brand from '../components/Brand.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';

/* 상단 바는 어느 페이지에도 없다. 사이트를 도는 길은 화면 아래 아이콘 줄 하나뿐이다. */
interface Props {
	title?: string;
	description?: string;
	/** 3D 인트로 재생 (홈에서만) */
	intro?: boolean;
	/** 본문 폭 — 글 읽는 페이지는 narrow */
	width?: 'wide' | 'narrow';
	/** 링크 공유·검색 미리보기 그림 (public 기준 경로, 1200×630) */
	image?: string;
	/** 한 화면에 딱 맞춘다 (홈). 스크롤이 없다 */
	fit?: boolean;
	/** 이 페이지가 자기 머리(제목·알약 줄)를 갖는가. 홈은 마크와 내용뿐이라 false */
	head?: boolean;
}

const {
	title = 'Matail · 심야 작업실',
	description = '한 명이 만드는 작은 게임 스튜디오. 브라우저에서 바로 즐길 수 있는 게임을 만들고, 만드는 과정을 기록합니다.',
	intro = false,
	width = 'wide',
	image = '/og/site.png',
	fit = false,
	head = true,
} = Astro.props;

// 대표 주소와 미리보기 그림은 절대 주소여야 한다 (astro.config 의 site)
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="ko" data-fit={fit ? '' : undefined}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0A0A0F" />

		<!-- 구글 서치 콘솔 소유 확인 (URL 접두어 속성 https://my-site.matail.workers.dev/). 지우면 확인이 풀린다 -->
		<meta name="google-site-verification" content="sLkkfdJ-DulFoSo-rsvtHzk7bWXKDg8GZBgnHppsZMI" />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Matail" />
		<meta property="og:locale" content="ko_KR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<link
			rel="stylesheet"
			as="style"
			crossorigin
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
		/>

		<title>{title}</title>

		{/* 페이지를 통째로 새로 받지 않고 가운데만 갈아끼운다.
		    마크와 아이콘 줄은 transition:persist 로 그대로 남으므로 다시 그려지지 않는다. */}
		<ClientRouter />

		<!-- 인트로 재생 여부를 첫 페인트 전에 결정한다 (깜빡임 방지) -->
		<script is:inline define:vars={{ intro }}>
			(function () {
				var el = document.documentElement;
				var on = false;
				if (intro) {
					try {
						var seen = sessionStorage.getItem('intro-played') === '1';
						var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
						var replay = location.hash === '#intro' || location.search.indexOf('intro=1') > -1;
						on = replay || (!seen && !reduce);
					} catch (e) {
						on = false;
					}
				}
				el.dataset.intro = on ? 'on' : 'off';

				// 인트로를 실제로 틀 때만 스프라이트를 미리 받는다 (재방문자에겐 낭비 안 되게)
				if (on) {
					['south', 'east', 'south-east', 'walk-0', 'walk-1', 'walk-2', 'walk-3'].forEach(function (n) {
						var link = document.createElement('link');
						link.rel = 'preload';
						link.as = 'image';
						link.href = '/sprites/' + n + '.png';
						document.head.appendChild(link);
					});
				}
			})();
		</script>

		<!-- 페이지를 갈아끼울 때는 인트로를 틀지 않는다. 첫 방문에 한 번 도는 연출이고,
		     "인트로 다시 보기" 링크는 data-astro-reload 로 진짜 새로고침을 시킨다. -->
		<script>
			document.addEventListener('astro:after-swap', function () {
				document.documentElement.dataset.intro = 'off';
			});
		</script>
	</head>
	<body>
		{intro && <Intro />}

		<div class="page" id="page">
			<main class:list={['main', width, { 'has-head': head }]}>
				<Brand />
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style is:global>
	/* ===== 한 화면에 딱 맞추기 (홈) =====
	   본문과 구석의 아이콘 줄을 100dvh 안에 나눠 갖는다. 스크롤이 없다.
	   #page 로 한정하는 게 중요하다 — 인트로의 노트북 화면 안에도 같은 .main 이 들어 있어서
	   전역으로 걸면 화면 속 사이트의 레이아웃까지 바뀐다. */
	html[data-fit] {
		overflow: hidden;
	}

	html[data-fit] #page {
		height: 100dvh;
		display: grid;
		grid-template-rows: 1fr auto;
	}

	/* 칸은 둘 아니면 셋이다 — 홈은 [마크 + 덱], 나머지는 [마크 + 페이지 머리 + 내용].
	   flex 로 늘리면 안 된다: 덱은 container-type: size 로 높이를 재는데,
	   flex-grow 로 생긴 높이에는 안쪽 100% 가 기대지 못해 카드가 0px 이 된다.
	   격자의 1fr 은 확정 높이라 그 문제가 없다. */
	html[data-fit] #page > .main {
		min-height: 0;
		/* 자기도 격자 칸이다. 안에 가로 스크롤 영역이 있으면 min-width: auto 때문에
		   칸을 밀어내며 화면 밖까지 자란다 (375px 화면에서 1120px 이 됐다) */
		min-width: 0;
		display: grid;
		grid-template-rows: auto 1fr;
		padding-bottom: 0;
	}

	/* 칸 수는 페이지가 알려준다 (head prop). 자식 개수로 세지 않는다 —
	   숨은 제목(position: absolute)이나 Astro 가 붙이는 <script> 까지 세어져서 덱이 납작해졌다. */
	html[data-fit] #page > .main.has-head {
		grid-template-rows: auto auto 1fr;
	}

	/* 격자 칸은 기본값이 min-width: auto 라, 안에 든 가로 스크롤 영역이
	   칸을 밀어내며 화면 밖까지 자란다. 0 으로 내려야 칸 안에서 스크롤된다. */
	html[data-fit] #page > .main > * {
		min-width: 0;
	}

	/* 다 넣기엔 너무 낮은 화면(가로로 누운 폰, 작은 노트북)에서는 스크롤을 돌려준다.
	   억지로 맞추면 카드가 우표만 해진다. */
	@media (max-height: 560px) {
		html[data-fit] {
			overflow: visible;
		}
		html[data-fit] #page {
			height: auto;
			display: block;
		}
		html[data-fit] #page > .main {
			display: block;
			padding-bottom: clamp(2rem, 6vw, 4rem);
		}
	}

	/* 인트로가 도는 동안엔 본문을 잠가둔다 */
	html[data-intro='on'] body {
		overflow: hidden;
	}
	html[data-intro='on'] #page {
		opacity: 0;
		pointer-events: none;
	}
	html.site-revealed #page {
		opacity: 1;
		transition: opacity 0.5s var(--ease-soft);
	}

	/* 인트로를 끝까지 본 경우엔 노트북 화면 속에서 이미 같은 화면을 보고 있었으므로
	   페이드 없이 한 프레임에 넘긴다 (겹쳐 페이드하면 중간에 한 번 어두워진다). */
	html.site-revealed.instant-reveal #page {
		transition: none;
	}
</style>
