---
/* 블로그 첫 화면 맨 위의 큰 카드.
   레퍼런스에서 가져온 건 셋이다 — 그림이 카드를 가득 채우고, 글자는 한가운데 모이고,
   이름은 작은 대문자로 밑에 깔린다. */
import type { CollectionEntry } from 'astro:content';
import { AUTHOR, CATEGORIES, fmtDate, type Category } from '../lib/blog';

interface Props {
	post: CollectionEntry<'blog'>;
	/** 'shelf' 는 좌우 선반의 첫 칸 — 가로로 눕지 않고 세로로 선다 */
	variant?: 'block' | 'shelf';
}
const { post, variant = 'block' } = Astro.props;
const d = post.data;
const cat = CATEGORIES[d.category as Category];
---

<a class:list={['feat', variant]} href={`/blog/${post.id}/`}>
	<div class="art" aria-hidden="true">
		{d.cover && <img src={d.cover} alt="" width="400" height="248" fetchpriority="high" decoding="async" />}
	</div>
	<span class="veil" aria-hidden="true"></span>

	<div class="inner">
		<h2>{d.title}</h2>
		<p class="excerpt">{d.description}</p>

		<div class="by">
			<img class="avatar" src={AUTHOR.avatar} alt="" width="26" height="26" loading="lazy" />
			<span class="name">{AUTHOR.name}</span>
			<span class="sep" aria-hidden="true">·</span>
			<time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time>
		</div>
	</div>
</a>

<style>
	.feat {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		min-height: 320px;
		max-height: 62vh;
		border-radius: var(--r-lg);
		border: 1px solid var(--border);
		overflow: hidden;
		color: var(--text);
		background: #0B0B11;
		transition: border-color var(--t-fast) var(--ease-soft), box-shadow var(--t-base) var(--ease-soft);
	}

	.feat:hover {
		border-color: var(--border-lit);
	}

	.art {
		position: absolute;
		inset: 0;
	}

	.art img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		image-rendering: pixelated;
		transform: scale(1.02);
		transition: transform 1.2s var(--ease-out);
		will-change: transform;
	}

	.feat:hover .art img { transform: scale(1.06); }

	/* 그림 위에 글자를 올리려면 가운데를 눌러 줘야 한다.
	   위아래로 어둡게 깔고, 가운데는 원형으로 한 번 더 눌렀다. */
	.veil {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(72% 66% at 50% 56%, rgba(5, 5, 8, 0.78), transparent 76%),
			linear-gradient(180deg, rgba(5, 5, 8, 0.62) 0%, rgba(5, 5, 8, 0.3) 40%, rgba(5, 5, 8, 0.86) 100%);
	}

	.inner {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		text-align: center;
		padding: clamp(1.5rem, 5vw, 3rem);
	}

	.inner h2 {
		margin: 0;
		font-size: clamp(1.75rem, 4.2vw, 3rem);
		/* 표제 무게는 전역 사다리(720)와 같은 자리에 둔다. 900 은 그림 위에서 특히 둔탁하다 */
		font-weight: 720;
		letter-spacing: -0.042em;
		line-height: 1.16;
		/* em 으로 재야 한글 기준이 된다 — 한 줄에 13자 안팎 */
		max-width: 13em;
		text-wrap: balance;
		/* 글씨 뒤에 검은 번짐을 깔면 글로우처럼 보인다. 읽히게 하는 일은 위의 막이 한다 */
	}

	.excerpt {
		margin: 0.9rem 0 0;
		max-width: 34rem;
		font-size: var(--fs-sm);
		line-height: 1.7;
		color: var(--text-dim);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.by {
		display: inline-flex;
		align-items: center;
		gap: var(--s-2);
		margin-top: var(--s-5);
		color: var(--text-dim);
	}

	/* 이름은 본문 글꼴, 날짜만 모노 — 한글에 모노 대문자를 씌우지 않는다 */
	.by .name {
		font-size: var(--fs-xs);
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.by time {
		font-family: var(--font-mono);
		font-size: var(--fs-mono);
		letter-spacing: 0.04em;
	}

	.avatar {
		width: 26px;
		height: 26px;
		border-radius: 50%;
		object-fit: cover;
		object-position: 50% 12%;
		image-rendering: pixelated;
		background: rgba(255, 180, 70, 0.12);
		border: 1px solid rgba(255, 180, 70, 0.35);
	}

	.sep { color: var(--text-mute); }

	/* ===== 선반의 첫 칸 =====
	   높이는 선반이 준다. 가로로 누운 16:9 대신 세로로 선 포스터가 된다. */
	/* 선반이 두 줄이므로 큰 카드는 두 줄을 한꺼번에 차지한다 */
	.feat.shelf {
		aspect-ratio: auto;
		min-height: 0;
		max-height: none;
		width: clamp(300px, 26vw, 460px);
		grid-row: span 2;
	}

	@media (max-width: 560px) {
		.feat { aspect-ratio: 4 / 5; max-height: none; }
		.feat.shelf { width: clamp(260px, 82vw, 320px); }
		.excerpt { display: none; }
	}
</style>
