---
/* 한 줄만 모아 보는 화면. 첫 화면과 같은 선반이고, 서 있는 글만 다르다. */
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import BlogNav from '../../../components/BlogNav.astro';
import PostShelf from '../../../components/PostShelf.astro';
import PostCard from '../../../components/PostCard.astro';
import { CATEGORIES, CATEGORY_ORDER, byNewest, type Category } from '../../../lib/blog';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return CATEGORY_ORDER.map((category) => ({
		params: { category },
		props: {
			category,
			posts: posts.filter((p) => p.data.category === category).sort(byNewest),
		},
	}));
}

type Props = {
	category: Category;
	posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
};

const { category, posts } = Astro.props as Props;
const cat = CATEGORIES[category];
---

<Layout title={`${cat.label} · my-site`} description={cat.blurb} width="wide" fit={true}>
	<header class="head">
		<div class="titles">
			<h1 data-reveal>
				{cat.label}
				<span class="n">{cat.en} · {posts.length}</span>
			</h1>
			<p class="lead" data-reveal style="--reveal-delay: 80">{cat.blurb}</p>
		</div>

		<div data-reveal style="--reveal-delay: 140"><BlogNav active={category} /></div>
	</header>

	<div class="stage" data-reveal style="--reveal-delay: 200">
		{
			posts.length > 0 ? (
				<PostShelf label={cat.label}>
					{posts.map((post) => (
						<PostCard post={post} variant="shelf" level={2} />
					))}
				</PostShelf>
			) : (
				<p class="empty">이 줄에는 아직 글이 없어요.</p>
			)
		}
	</div>
</Layout>

<style>
	.head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--s-5);
		flex-wrap: wrap;
		padding: 0 0 clamp(1rem, 2.5vw, 1.5rem);
	}

	.titles h1 {
		display: flex;
		align-items: baseline;
		gap: var(--s-3);
		margin: 0 0 0.5rem;
		font-size: clamp(1.75rem, 3.6vw, 2.9rem);
	}

	.n {
		font-family: var(--font-mono);
		font-size: var(--fs-xs);
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.04em;
		color: var(--text-mute);
	}

	.titles .lead {
		margin: 0;
		font-size: var(--fs-sm);
	}

	.head :global(.bnav) {
		padding-bottom: 0;
	}

	.stage {
		min-height: 0;
		min-width: 0;
	}

	.empty {
		padding: 3rem 0;
		color: var(--text-mute);
	}

	@media (max-width: 720px) {
		.head {
			align-items: flex-start;
			gap: var(--s-4);
		}
	}
</style>
