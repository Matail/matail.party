---
/* 통계 탭 개요 — 공개 통계가 있는 게임(games 의 stats: true)을 한 화면에 모은 대시보드.
   게임마다 자세한 페이지는 /stats/<id>/ 에 따로 있고, 위 알약(StatsNav)과 카드의 ↗ 로 간다.
   숫자는 게임별 실시간 통계와 같은 웹소켓(/api/streams/live · /api/aimbooster/live)에서 받아 그리기만 한다 (scripts/stats-overview.ts).
   카드 모양 · 색은 게임별 통계 페이지와 같다. STREAMS 카드는 관리자가 끈 공개 카드(public_cards)를 따라 숨는다. */
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import StatsNav from '../../components/StatsNav.astro';

const pick = async (id: 'streams' | 'aimbooster') => {
	const g = await getEntry('games', id);
	if (!g) throw new Error(`games/${id} 가 없다`);
	return { id, title: g.data.title, accent: g.data.accent ?? '#FFB446', url: g.data.url };
};
const streams = await pick('streams');
const aim = await pick('aimbooster');
const games = [streams, aim];
---

<Layout title="통계 · Matail" description="Matail 게임들에서 모은 익명 플레이 통계를 한눈에 — 지금 하는 사람, 점수 · 기록 분포, 실시간 소식." width="wide">
	<div class="dash" data-overview data-games={JSON.stringify(games)}>
		<h1 class="sr-only">통계</h1>

		<header class="bar" data-reveal>
			<StatsNav active="all" />
			<span class="status" data-status data-state="wait" role="status"><i aria-hidden="true"></i><span data-v="status">연결하는 중…</span></span>
		</header>

		<section class="board" aria-label="요약" data-reveal style="--reveal-delay: 100">
			<article class="panel span-2" data-card="score" style={`--g: ${streams.accent}`}>
				<div class="p-head">
					<span class="p-label"><i class="g"></i>{streams.title} · 난이도별 평균 점수</span>
					<a class="go" href={`/stats/${streams.id}/`} aria-label={`${streams.title} 통계 자세히`}>↗</a>
				</div>
				<div class="p-top">
					<div class="p-value"><span data-v="sAvg">–</span><span class="unit">점 사람 평균</span></div>
					<dl class="side">
						<div><dt>AI 평균</dt><dd data-v="sAiAvg">–</dd></div>
						<div><dt>가장 많이 둔 난이도</dt><dd data-v="sTopLevel">–</dd></div>
					</dl>
				</div>
				<div class="chart" data-chart="score" role="img" aria-label="난이도별 사람과 AI 평균 점수 선"></div>
				<div class="legend"><span><i class="sw you"></i>사람</span><span><i class="sw ai"></i>AI</span></div>
			</article>

			<article class="panel" data-card="reaction" style={`--g: ${aim.accent}`}>
				<div class="p-head">
					<span class="p-label"><i class="g"></i>반응 시간</span>
					<a class="go" href={`/stats/${aim.id}/`} aria-label={`${aim.title} 통계 자세히`}>↗</a>
				</div>
				<div class="p-top">
					<div class="p-value"><span data-v="aReaction">–</span><span class="unit">ms</span></div>
					<dl class="side small">
						<div><dt>빠른 10%</dt><dd data-v="aReactionFast">–</dd></div>
						<div><dt>느린 10%</dt><dd data-v="aReactionSlow">–</dd></div>
					</dl>
				</div>
				<div class="chart" data-chart="reaction" role="img" aria-label={`${aim.title} 판별 반응 시간 중앙값 분포`}></div>
				<p class="foot">{aim.title} · 판마다 과녁을 맞히기까지 걸린 시간의 한가운데</p>
			</article>

			<article class="panel" data-card="survival" style={`--g: ${aim.accent}`}>
				<div class="p-head">
					<span class="p-label"><i class="g"></i>버틴 시간</span>
					<a class="go" href={`/stats/${aim.id}/`} aria-label={`${aim.title} 통계 자세히`}>↗</a>
				</div>
				<div class="p-top">
					<div class="p-value"><span data-v="aSurvival">–</span><span class="unit">초</span></div>
					<dl class="side small">
						<div><dt>상위 10%</dt><dd data-v="aSurvivalTop">–</dd></div>
						<div><dt>최고</dt><dd data-v="aBest">–</dd></div>
					</dl>
				</div>
				<div class="chart" data-chart="survival" role="img" aria-label={`${aim.title} 판별 버틴 시간 분포`}></div>
				<p class="foot">{aim.title} · 판별 버틴 시간의 한가운데</p>
			</article>

			<article class="panel" data-card="runs">
				<div class="p-head"><span class="p-label">시작한 판</span></div>
				<div class="p-value big"><span data-v="started">–</span></div>
				<div class="meter" data-meter="runs"></div>
				<div class="m-legend">
					<span><b data-v="finishedAll">–</b> 끝까지</span>
					<span><b data-v="abandoned">–</b> 그만둠</span>
				</div>
			</article>

			<article class="panel" data-card="win" style={`--g: ${streams.accent}`}>
				<div class="p-head">
					<span class="p-label"><i class="g"></i>사람이 AI 를 이긴 비율</span>
					<a class="go" href={`/stats/${streams.id}/`} aria-label={`${streams.title} 통계 자세히`}>↗</a>
				</div>
				<div class="p-value big"><span data-v="sWinRate">–</span><span class="unit">%</span></div>
				<div class="meter" data-meter="win"></div>
				<div class="m-legend">
					<span><i class="sw you"></i><b data-v="sWon">–</b> 사람 승</span>
					<span><i class="sw ai"></i><b data-v="sLost">–</b> AI 승</span>
				</div>
			</article>

			<article class="panel span-2" data-card="games">
				<div class="p-head"><span class="p-label">게임별 오늘</span></div>
				<ul class="games">
					{
						games.map((g) => (
							<li>
								<a class="game" href={`/stats/${g.id}/`} style={`--g: ${g.accent}`} data-game={g.id}>
									<span class="gm-head">
										<span class="gm-name"><i class="g"></i>{g.title}</span>
										<span class="gm-live" data-g="playing" hidden></span>
										<span class="gm-count"><b data-g="today">–</b><span> / </span><span data-g="finished">–</span>판</span>
									</span>
									<span class="gm-sub">
										<span class="gm-best">↳ 오늘 최고 <b data-g="todayBest">–</b></span>
										<span class="mini" data-g="bar" aria-hidden="true"><i></i></span>
										<span class="gm-all" data-g="best"></span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</article>
		</section>

		<section class="feed" aria-label="실시간 소식" data-reveal style="--reveal-delay: 180">
			<div class="f-head">
				<div class="f-tabs" role="group" aria-label="실시간 소식 — 게임 고르기">
					<button type="button" class="pill on" data-filter="all" aria-pressed="true" title="모든 게임의 실시간 소식"><i class="live-dot" aria-hidden="true"></i>LIVE</button>
					{games.map((g) => <button type="button" class="pill" data-filter={g.id} aria-pressed="false">{g.title}</button>)}
				</div>
				<a class="pill" href="/" title="게임 하러 가기">PLAY ↗</a>
			</div>
			<div class="panel table">
				<table>
					<thead>
						<tr><th>언제</th><th>게임</th><th class="n">기록</th><th>상태</th><th class="c-detail">내용</th><th class="c-go"><span class="sr-only">이동</span></th></tr>
					</thead>
					<tbody data-feed>
						<tr class="empty"><td colspan="6">이 페이지를 연 뒤 시작하거나 끝난 판이 여기 실시간으로 올라와요.</td></tr>
					</tbody>
				</table>
			</div>
			<p class="note">판 하나하나를 저장해 두지 않아요 — 이 페이지가 받은 공개 집계가 바뀐 만큼만 보여 주고, 새로고침하면 비워져요.</p>
		</section>

		<div class="tip" data-tip hidden></div>
	</div>
</Layout>

<style>
	/* 게임별 통계 페이지와 같은 카드 · 색. 데이터 색 역할도 같다 (사람 #3987e5 · AI #e66767 · 단일 계열 #22ab9b) */
	.dash {
		--card: #111116;
		--panel: #16161c;
		--line: rgba(255, 255, 255, 0.07);
		--ink: #edebe6;
		--ink-2: #a7a5ae;
		--ink-3: #7c7a84;
		--you: #3987e5;
		--ai: #e66767;
		--teal: #22ab9b;
		--draw: #6b6a73;
		--track: rgba(255, 255, 255, 0.06);
		max-width: 960px;
		margin: 0 auto;
		padding-bottom: 4rem;
	}

	/* ── 머리: 알약 + 연결 상태 ── */
	.bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: clamp(1rem, 3vw, 2rem) 0 16px; }
	.status {
		display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border-radius: 999px;
		background: var(--card); border: 1px solid var(--line); font-size: 0.8rem; color: var(--ink-2); font-variant-numeric: tabular-nums;
	}
	.status i { width: 8px; height: 8px; border-radius: 50%; background: var(--ink-3); }
	.status[data-state='live'] i { background: var(--teal); animation: beat 2s ease-in-out infinite; }
	.status[data-state='poll'] i { background: var(--lamp); }

	@keyframes beat {
		0%, 100% { box-shadow: 0 0 0 0 rgba(34, 171, 155, 0.5); }
		50% { box-shadow: 0 0 0 5px rgba(34, 171, 155, 0); }
	}

	/* ── 카드 판: 바깥 틀(.card 색) 안에 패널이 4칸 격자로 ── */
	.board {
		display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-flow: dense; gap: 12px;
		padding: 12px; border-radius: 20px; background: var(--card); border: 1px solid var(--line);
	}
	.panel {
		display: flex; flex-direction: column; min-width: 0;
		padding: 16px; border-radius: 14px; background: var(--panel); border: 1px solid var(--line);
	}
	.span-2 { grid-column: span 2; }
	[data-card][hidden] { display: none; }

	.p-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; min-height: 22px; }
	.p-label { display: inline-flex; align-items: center; gap: 7px; font-size: 0.8rem; color: var(--ink-2); min-width: 0; }
	.dash :global(.g) { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--g, var(--ink-3)); }
	.go {
		flex: none; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%;
		color: var(--ink-3); font-size: 0.8rem; transition: background var(--t-fast) var(--ease-soft), color var(--t-fast) var(--ease-soft);
	}
	.go:hover { background: rgba(255, 255, 255, 0.06); color: var(--ink); }

	.p-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin: 2px 0 10px; }
	.p-value { display: flex; align-items: baseline; gap: 6px; font-size: 1.9rem; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.2; }
	.p-value.big { font-size: 2.3rem; margin: 4px 0 14px; }
	.unit { font-size: 0.85rem; font-weight: 500; color: var(--ink-2); }

	.side { display: grid; gap: 2px; margin: 4px 0 0; font-size: 0.78rem; }
	.side div { display: flex; justify-content: space-between; gap: 14px; }
	.side dt { color: var(--ink-3); }
	.side dd { margin: 0; color: var(--ink); font-variant-numeric: tabular-nums; text-align: right; }
	.side.small { gap: 0; font-size: 0.72rem; }
	.side.small div { gap: 6px; }
	.side dt, .side dd { white-space: nowrap; }

	.chart { position: relative; margin-top: auto; }
	.chart :global(svg) { display: block; width: 100%; height: auto; overflow: visible; }
	.chart :global(text) { fill: var(--ink-3); font-size: 11px; font-family: inherit; }
	.chart :global(.cross) { opacity: 0; transition: opacity var(--t-fast) var(--ease-soft); }
	.chart :global(.col:hover .cross) { opacity: 1; }
	.foot { margin: 8px 0 0; font-size: 0.72rem; color: var(--ink-3); line-height: 1.5; }

	.legend { display: flex; gap: 16px; font-size: 0.78rem; color: var(--ink-2); margin-top: 8px; }
	.sw { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 6px; }
	.sw.you { background: var(--you); }
	.sw.ai { background: var(--ai); }

	/* 막대 미터: 끝까지 / 그만둠, 사람 승 / 무 / AI 승. 칸 사이는 2px 틈 */
	.meter { display: flex; gap: 2px; height: 6px; margin-top: auto; border-radius: 3px; background: var(--track); overflow: hidden; }
	.meter :global(span) { display: block; height: 100%; border-radius: 3px; min-width: 0; }
	.m-legend { display: flex; justify-content: space-between; gap: 8px; margin-top: 10px; font-size: 0.78rem; color: var(--ink-2); white-space: nowrap; }
	.m-legend b { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; margin-right: 3px; }

	/* 게임별 오늘 — 이름 · 오늘/전체, 아래 줄에 오늘 최고와 역대 최고 대비 */
	.games { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 4px; }
	.game {
		display: grid; gap: 6px; padding: 10px; margin: 0 -10px; border-radius: 10px; color: var(--ink);
		transition: background var(--t-fast) var(--ease-soft);
	}
	.game:hover { background: rgba(255, 255, 255, 0.04); color: var(--ink); }
	.gm-head { display: flex; align-items: center; gap: 10px; }
	.gm-name { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.92rem; }
	.gm-live { font-size: 0.72rem; color: #7ee0d3; padding: 1px 7px; border-radius: 6px; background: rgba(34, 171, 155, 0.14); }
	.gm-count { margin-left: auto; font-size: 0.85rem; color: var(--ink-2); font-variant-numeric: tabular-nums; }
	.gm-count b { color: var(--lamp); font-weight: 600; }
	.gm-sub { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; font-size: 0.78rem; color: var(--ink-3); }
	.gm-best b { color: var(--ink-2); font-weight: 500; font-variant-numeric: tabular-nums; }
	.mini { justify-self: end; width: min(120px, 100%); height: 4px; border-radius: 2px; background: var(--track); overflow: hidden; }
	.mini i { display: block; width: 0; height: 100%; border-radius: 2px; background: var(--teal); transition: width var(--t-base) var(--ease-out); }
	.mini[hidden] { display: none; }
	.gm-all { font-variant-numeric: tabular-nums; min-width: 4.5rem; text-align: right; }

	/* ── 실시간 소식 ── */
	.feed { margin-top: 16px; padding: 12px; border-radius: 20px; background: var(--card); border: 1px solid var(--line); }
	.f-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
	.f-tabs { display: flex; gap: 6px; flex-wrap: wrap; }
	.live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ai); }
	.pill.on .live-dot { background: #8f1d1d; }

	/* 줄은 스크립트가 그려 넣으므로(범위 밖) 표 안은 :global 로 */
	.table { position: relative; padding: 4px 8px; overflow-x: auto; }
	table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
	.table :global(th), .table :global(td) { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
	.table :global(tr:last-child td) { border-bottom: 0; }
	.table :global(th) { color: var(--ink-3); font-weight: 500; font-size: 0.75rem; }
	.table :global(td) { color: var(--ink); font-variant-numeric: tabular-nums; }
	.table :global(.n) { text-align: right; }
	.table :global(td.when) { color: var(--ink-2); }
	.table :global(td.c-detail) { color: var(--ink-2); white-space: normal; }
	.table :global(.c-go) { text-align: right; width: 1%; }
	tbody :global(tr.fresh) { animation: fresh 1.6s var(--ease-out); }
	tbody :global(tr.empty td) { padding: 28px 8px; text-align: center; color: var(--ink-3); white-space: normal; }
	@keyframes fresh {
		from { background: rgba(255, 180, 70, 0.08); }
		to { background: transparent; }
	}

	/* 상태: 색은 아이콘이 갖고 글자는 글자색 그대로 */
	tbody :global(.badge) { display: inline-flex; align-items: center; gap: 6px; }
	tbody :global(.badge svg) { width: 14px; height: 14px; flex: none; }
	tbody :global(.gname) { display: inline-flex; align-items: center; gap: 8px; }
	tbody :global(.rec) { color: var(--lamp); font-weight: 600; }
	tbody :global(.acts) { display: inline-flex; gap: 6px; justify-content: flex-end; }
	tbody :global(.pill) { min-height: 28px; padding: 0 10px; font-size: 0.6875rem; }
	tbody :global(.pill.icon) { width: 28px; padding: 0; justify-content: center; }

	.note { margin: 10px 4px 2px; font-size: 0.72rem; color: var(--ink-3); }

	.tip {
		position: fixed; z-index: 50; pointer-events: none; padding: 6px 9px; border-radius: 8px;
		background: #1f1f27; border: 1px solid rgba(255, 255, 255, 0.12); font-size: 0.78rem; color: var(--ink);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5); white-space: nowrap;
	}

	@media (max-width: 900px) {
		.board { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 640px) {
		.table :global(.c-detail) { display: none; }
	}
	@media (max-width: 560px) {
		.board { grid-template-columns: minmax(0, 1fr); padding: 8px; gap: 8px; }
		.span-2 { grid-column: auto; }
		.p-top { flex-direction: column; gap: 4px; }
		.side { width: 100%; }
		.feed { padding: 8px; }
		.table { padding: 0 4px; }
		.table :global(th), .table :global(td) { padding: 9px 5px; }
		.table :global(td .gname) { white-space: normal; }
		.table :global(.c-go), .f-head > .pill { display: none; }
		.bar .status { width: 100%; justify-content: center; }
	}
</style>

<script>
	import { startOverview } from '../../scripts/stats-overview.ts';

	const boot = () => document.querySelectorAll<HTMLElement>('[data-overview]').forEach((el) => startOverview(el));
	boot();
	document.addEventListener('astro:page-load', boot);
</script>
