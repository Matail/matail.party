---
/* 소개 — 글 페이지와 같은 방식이다. 아래로 흐르지 않고 칸이 옆으로 이어진다.
   내용이 짧아서 넓은 화면에서는 두 칸에 다 들어가고, 좁아지면 좌우로 넘긴다. */
import Layout from '../layouts/Layout.astro';

const facts = [
	{ k: '만드는 사람', v: '한 명' },
	{ k: '쓰는 도구', v: 'Unity · HTML5 · Astro' },
	{ k: '목표', v: '30초 안에 시작되는 게임' },
	{ k: '작업 시간', v: '주로 새벽' },
];
---

<Layout
	title="소개 · Matail"
	description="한 명이 운영하는 작은 인디 게임 스튜디오. 브라우저에서 바로 즐기는 게임을 만듭니다."
	width="wide"
	fit={true}
>
	<header class="head" data-reveal>
		<div class="titles">
			<h1>
				안녕하세요, <span class="accent">반가워요.</span>
			</h1>
			<p class="lead">
				웹에서 바로 플레이할 수 있는 작은 게임을 만들고 있어요. 설치도, 가입도, 결제도 없이
				링크 하나로 시작되는 게임이요.
			</p>
		</div>
	</header>

	<div class="reader-wrap" data-hscroll-wrap data-reveal style="--reveal-delay: 120">
		<div
			class="reader"
			data-hscroll
			data-center
			tabindex="0"
			role="region"
			aria-label="소개 — 좌우로 넘겨 읽으세요"
		>
			<dl class="facts">
				{
					facts.map((f) => (
						<div class="fact">
							<dt>{f.k}</dt>
							<dd>{f.v}</dd>
						</div>
					))
				}
			</dl>

			<div class="body">
				<h2>무엇을 만들어요?</h2>
				<p>
					브라우저만 있으면 누구나 30초 안에 시작할 수 있는 캐주얼 게임을 좋아해요. 규칙은 한 줄로
					설명되고, 한 판은 몇 분이면 끝나고, 다시 하고 싶어지는 종류의 게임이요.
				</p>

				<h2>왜 만들어요?</h2>
				<p>
					만드는 과정 자체가 재밌어서요. 작은 게임 하나가 누군가의 5분을 즐겁게 만들 수 있다면,
					그걸로 충분하다고 생각해요. 그 과정에서 배운 건 <a href="/blog">작업 기록</a>에 남겨둡니다.
				</p>

				<h2>어떻게 만들어요?</h2>
				<p>
					기획은 짧게, 프로토타입은 빠르게. 재미가 확인되면 다듬고, 아니면 접습니다. 접은 것도
					기록으로는 남겨요.
				</p>

				<h2>연락</h2>
				<p>
					하고 싶은 말이 있다면 <a href="mailto:hello@example.com">hello@example.com</a>으로 보내주세요.
					버그 제보는 특히 환영합니다.
				</p>
			</div>
		</div>

		<span class="hs-edge left" aria-hidden="true"></span>
		<span class="hs-edge right" aria-hidden="true"></span>
	</div>
</Layout>

<style>
	/* 가운데로 모은다 — 마크가 화면 위 가운데에 있으므로 제목도 그 아래 같은 축에 선다 */
	.head {
		padding: 0 0 clamp(1rem, 2.5vw, 1.5rem);
		text-align: center;
	}

	.titles h1 {
		margin: 0 0 0.6rem;
		font-size: clamp(1.75rem, 3.6vw, 2.9rem);
	}

	.titles .lead {
		margin: 0 auto;
		font-size: var(--fs-sm);
		max-width: 44rem;
	}

	/* 첫 칸 맨 위 — 숫자판처럼 사실만 적어 둔다 */
	.facts {
		text-align: center;
		break-inside: avoid;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
		border-radius: var(--r-md);
		overflow: hidden;
		margin: 0 0 var(--s-6);
	}

	.fact {
		background: var(--bg);
		padding: var(--s-3) var(--s-4);
	}

	.fact dt {
		font-family: var(--font-mono);
		font-size: var(--fs-micro);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-mute);
		margin-bottom: 0.35rem;
	}

	.fact dd {
		margin: 0;
		font-size: var(--fs-sm);
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.body {
		font-size: var(--fs-md);
		line-height: 1.8;
		letter-spacing: -0.003em;
		color: #DCD9D3;
	}

	.body h2 {
		font-size: var(--fs-xl);
		line-height: 1.35;
		margin: 1.75rem 0 0.8rem;
		color: var(--text);
		break-after: avoid;
	}

	.body h2:first-child {
		margin-top: 0;
	}

	.body p {
		margin: 0 0 1.35rem;
	}

	.body a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>

<script>
	import { initHScroll } from '../scripts/hscroll.js';

	/* 내용이 한 화면에 다 들어가면 쓰인 칸만큼으로 폭을 줄여 가운데에 세운다.
	   칸은 왼쪽부터 채워지므로, 그대로 두면 넓은 화면에서 글이 왼쪽 칸에만 몰린다.
	   줄인 폭은 쓰인 칸들의 폭과 같아서 칸 수도, 칸 너비도 바뀌지 않는다.
	   넘쳐서 옆으로 넘겨야 하면 손대지 않는다. */
	function centerReaders() {
		document.querySelectorAll<HTMLElement>('[data-hscroll][data-center]').forEach((el) => {
			el.style.maxWidth = '';
			el.style.marginInline = '';
			if (el.scrollWidth - el.clientWidth > 1) return;

			const range = document.createRange();
			range.selectNodeContents(el);
			const left = el.getBoundingClientRect().left;
			let right = left;
			for (const r of range.getClientRects()) right = Math.max(right, r.right);
			const used = Math.ceil(right - left);
			if (used <= 0 || used >= el.clientWidth) return;

			el.style.maxWidth = `${used}px`;
			el.style.marginInline = 'auto';
		});
	}

	function init() {
		initHScroll();
		centerReaders();
		if (document.fonts) document.fonts.ready.then(centerReaders);
	}

	init();
	document.addEventListener('astro:page-load', init);
	window.addEventListener('resize', centerReaders);
</script>
